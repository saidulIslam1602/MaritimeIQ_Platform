## 3. Domain Models in MaritimeIQ

### Vessel Model

```csharp
public class Vessel
{
    public int Id { get; private set; }
    public string Name { get; private set; }
    public string IMONumber { get; private set; }
    public VesselType Type { get; private set; }
    public VesselStatus Status { get; private set; }
    public Position? CurrentPosition { get; private set; }
    
    // Business logic
    public void UpdatePosition(Position position)
    {
        if (position == null)
            throw new ArgumentNullException(nameof(position));
        
        CurrentPosition = position;
    }
    
    public void Activate()
    {
        if (Status == VesselStatus.Active)
            throw new InvalidOperationException("Vessel is already active");
        
        Status = VesselStatus.Active;
    }
}
```

### AIS Message Model

```csharp
public class AISVesselData
{
    public string MMSI { get; set; }  // Maritime Mobile Service Identity
    public double Latitude { get; set; }
    public double Longitude { get; set; }
    public double Speed { get; set; }
    public double Heading { get; set; }
    public DateTime Timestamp { get; set; }
    
    // Validation
    public bool IsValid()
    {
        return !string.IsNullOrEmpty(MMSI) &&
               MMSI.Length == 9 &&
               Latitude >= -90 && Latitude <= 90 &&
               Longitude >= -180 && Longitude <= 180 &&
               Speed >= 0 && Speed <= 40;
    }
}
```

### Environmental Data Model

```csharp
public class EnvironmentalSensorData
{
    public int VesselId { get; set; }
    public DateTime MeasurementTime { get; set; }
    public double CO2EmissionKg { get; set; }
    public double NOxEmissionKg { get; set; }
    public double SOxEmissionKg { get; set; }
    public double FuelConsumptionLiters { get; set; }
    
    // Business logic
    public bool IsCompliant()
    {
        return CO2EmissionKg <= 50.0 &&  // IMO 2030 targets
               NOxEmissionKg <= 5.0 &&
               SOxEmissionKg <= 1.5;
    }
}

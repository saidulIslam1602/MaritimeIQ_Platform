## 6. Automated Remediation

### What is Automated Remediation?

**Automated Remediation** automatically fixes data quality issues when possible.

### MaritimeIQ Implementation

```csharp
public class DataQualityService : BackgroundService
{
    public async Task RemediateDataQualityIssuesAsync(DataFrame df)
    {
        // 1. Handle missing values
        df = HandleMissingValues(df);
        
        // 2. Fix outliers
        df = FixOutliers(df);
        
        // 3. Standardize formats
        df = StandardizeFormats(df);
        
        // 4. Remove duplicates
        df = RemoveDuplicates(df);
        
        return df;
    }
    
    private DataFrame HandleMissingValues(DataFrame df)
    {
        // Forward fill for time-series data
        foreach (var column in df.Columns)
        {
            if (IsTimeSeriesColumn(column))
            {
                df = df.WithColumn(column, 
                    when(col(column).isNull(), 
                        lag(col(column), 1).over(Window.partitionBy("VesselId").orderBy("Timestamp")))
                    .otherwise(col(column))
                );
            }
            else
            {
                // Use median for numeric columns
                if (IsNumeric(column))
                {
                    var median = df.Stat.ApproxQuantile(column, new double[] { 0.5 }, 0.25)[0];
                    df = df.WithColumn(column, 
                        when(col(column).isNull(), lit(median))
                        .otherwise(col(column))
                    );
                }
            }
        }
        
        return df;
    }
    
    private DataFrame FixOutliers(DataFrame df)
    {
        foreach (var column in df.Columns)
        {
            if (IsNumeric(column))
            {
                var stats = CalculateStatistics(df, column);
                var lowerBound = stats.Mean - 3 * stats.StdDev;
                var upperBound = stats.Mean + 3 * stats.StdDev;
                
                df = df.WithColumn(column,
                    when(col(column) < lowerBound, lit(lowerBound))
                    .when(col(column) > upperBound, lit(upperBound))
                    .otherwise(col(column))
                );
            }
        }
        
        return df;
    }
}
```

**Benefits**:
- Automatic data cleaning
- Reduced manual effort
- Consistent remediation
- Improved data quality


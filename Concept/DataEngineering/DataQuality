## 4. Rule-Based Validation

### What is Rule-Based Validation?

**Rule-Based Validation** uses predefined rules to validate data quality.

### MaritimeIQ Implementation

```csharp
public class DataQualityValidator
{
    private readonly List<ValidationRule> _rules;
    
    public DataQualityValidator()
    {
        _rules = new List<ValidationRule>
        {
            new ValidationRule
            {
                Name = "Latitude Range",
                Column = "Latitude",
                Rule = (value) => {
                    var lat = Convert.ToDouble(value);
                    return lat >= -90 && lat <= 90;
                },
                ErrorMessage = "Latitude must be between -90 and 90"
            },
            new ValidationRule
            {
                Name = "Longitude Range",
                Column = "Longitude",
                Rule = (value) => {
                    var lon = Convert.ToDouble(value);
                    return lon >= -180 && lon <= 180;
                },
                ErrorMessage = "Longitude must be between -180 and 180"
            },
            new ValidationRule
            {
                Name = "MMSI Format",
                Column = "MMSI",
                Rule = (value) => {
                    var mmsi = value.ToString();
                    return mmsi != null && mmsi.Length == 9 && mmsi.All(char.IsDigit);
                },
                ErrorMessage = "MMSI must be 9 digits"
            },
            new ValidationRule
            {
                Name = "Speed Range",
                Column = "Speed",
                Rule = (value) => {
                    var speed = Convert.ToDouble(value);
                    return speed >= 0 && speed <= 40;
                },
                ErrorMessage = "Speed must be between 0 and 40 knots"
            }
        };
    }
    
    public ValidationResult Validate(DataFrame df)
    {
        var result = new ValidationResult
        {
            TotalRows = df.Count(),
            ValidRows = 0,
            InvalidRows = 0,
            Errors = new List<ValidationError>()
        };
        
        foreach (var row in df.Rows)
        {
            var rowValid = true;
            foreach (var rule in _rules)
            {
                var value = row[rule.Column];
                if (!rule.Rule(value))
                {
                    rowValid = false;
                    result.Errors.Add(new ValidationError
                    {
                        Row = row,
                        Rule = rule.Name,
                        Message = rule.ErrorMessage
                    });
                }
            }
            
            if (rowValid)
            {
                result.ValidRows++;
            }
            else
            {
                result.InvalidRows++;
            }
        }
        
        result.QualityScore = (double)result.ValidRows / result.TotalRows * 100;
        return result;
    }
}
```

**Benefits**:
- Automated validation
- Consistent rules
- Comprehensive coverage
- Detailed error reporting


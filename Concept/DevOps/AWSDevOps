## 3. EKS (Elastic Kubernetes Service)

### What is EKS?

**EKS** is a managed Kubernetes service for running containerized applications.

**Key Features**:
- Managed Kubernetes control plane
- Auto-scaling node groups
- Integration with AWS services
- High availability
- Security and compliance

### MaritimeIQ EKS Configuration

```hcl
# EKS Cluster
resource "aws_eks_cluster" "main" {
  name     = "${var.app_name}-eks"
  role_arn = aws_iam_role.eks.arn
  version  = "1.27"
  
  vpc_config {
    subnet_ids              = module.vpc.private_subnets
    endpoint_private_access = true
    endpoint_public_access  = true
  }
  
  depends_on = [
    aws_iam_role_policy_attachment.eks_cluster_policy,
    aws_iam_role_policy_attachment.eks_service_policy,
  ]
  
  tags = {
    Name        = "${var.app_name}-eks"
    Environment = var.environment
  }
}

# EKS Node Group
resource "aws_eks_node_group" "main" {
  cluster_name    = aws_eks_cluster.main.name
  node_group_name = "${var.app_name}-nodes"
  node_role_arn   = aws_iam_role.eks_node.arn
  subnet_ids      = module.vpc.private_subnets
  
  instance_types = ["t3.medium"]
  capacity_type  = "ON_DEMAND"
  
  scaling_config {
    desired_size = var.environment == "prod" ? 3 : 2
    max_size     = 10
    min_size     = 1
  }
  
  update_config {
    max_unavailable = 1
  }
  
  tags = {
    Name        = "${var.app_name}-nodes"
    Environment = var.environment
  }
}
```

### Deploying to EKS

```bash
# Configure kubectl
aws eks update-kubeconfig --name maritime-eks --region us-east-1

# Deploy application
kubectl apply -f k8s/maritime-api.yaml

# Check status
kubectl get pods
kubectl get services
```

### Kubernetes Deployment

```yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: maritime-api
spec:
  replicas: 3
  selector:
    matchLabels:
      app: maritime-api
  template:
    metadata:
      labels:
        app: maritime-api
    spec:
      containers:
      - name: maritime-api
        image: maritime-ecr.aws.com/maritime-api:latest
        ports:
        - containerPort: 80
        env:
        - name: ConnectionStrings__DefaultConnection
          valueFrom:
            secretKeyRef:
              name: maritime-secrets
              key: sql-connection-string
        resources:
          requests:
            memory: "256Mi"
            cpu: "250m"
          limits:
            memory: "512Mi"
            cpu: "500m"
        livenessProbe:
          httpGet:
            path: /health
            port: 80
          initialDelaySeconds: 30
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /ready
            port: 80
          initialDelaySeconds: 5
          periodSeconds: 5
---
apiVersion: v1
kind: Service
metadata:
  name: maritime-api
spec:
  type: LoadBalancer
  selector:
    app: maritime-api
  ports:
  - port: 80
    targetPort: 80
```

